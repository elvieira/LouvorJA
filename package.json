{
  "name": "louvorja",
  "version": "1.7.9",
  "description": "Aplicativo de projeção de músicas e mídias para cultos.",
  "author": {
    "name": "Elias Vieira",
    "email": "elvieiradev@gmail.com"
  },
  "private": true,
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "version:major": "npm version major",
    "version:minor": "npm version minor",
    "version:patch": "npm version patch",
    "version:max": "npm version major",
    "version:min": "npm version minor",
    "version:bug": "npm version patch",
    "serve": "vite preview",
    "build": "vite build",
    "lint": "eslint src electron --ext .vue,.js,.ts --fix",
    "dev": "vite",
    "host": "vite --host",
    "files": "node node/server.js",
    "git:tag": "git tag -a -f v%npm_package_version% -m \"Versão %npm_package_version%\" && git push origin -f v%npm_package_version% && git push -u origin main",
    "git:publish": "git pull origin main && git checkout main && git merge develop && git push -u origin main && git checkout develop",
    "electron:dev": "vite",
    "electron:build": "vite build --base=./ && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "archiver": "^7.0.1",
    "basic-ftp": "^5.0.5",
    "core-js": "^3.46.0",
    "dotenv": "^16.6.1",
    "electron-updater": "^6.8.9",
    "fs-extra": "^11.3.2",
    "roboto-fontface": "*",
    "sql.js": "^1.14.1",
    "systeminformation": "^5.31.11",
    "vue": "^3.5.22",
    "vue-country-flag-next": "^2.3.2",
    "vue-fullscreen": "^3.1.3",
    "vue-i18n": "^10.0.8",
    "vue-json-pretty": "^2.6.0",
    "vue-router": "^4.6.3",
    "vue3-shortkey": "^4.0.0",
    "vuedraggable": "^4.1.0",
    "vuetify": "^3.7.4",
    "vuex": "^4.1.0",
    "webfontloader": "^1.6.28"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.2",
    "@types/sql.js": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^10.0.3",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.31.0",
    "sass": "^1.83.0",
    "sharp": "^0.35.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-pwa": "^0.21.2",
    "vite-plugin-vuetify": "^2.0.4",
    "wait-on": "^9.0.10"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "build": {
    "appId": "com.louvorja.app",
    "productName": "Louvor JA",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      "resources/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "elvieira",
      "repo": "LouvorJA"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/ico/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/ico/favicon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/ico/favicon.png"
    }
  }
}
