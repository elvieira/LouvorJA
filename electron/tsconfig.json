{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "outDir": "../dist-electron-ts",
    "rootDir": ".",
    "noEmit": false,
    "declaration": true,
    "strict": false,
    "allowJs": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["./**/*.ts", "./**/*.js"],
  "exclude": ["../node_modules"]
}
